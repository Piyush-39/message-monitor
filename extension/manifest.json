{
  "manifest_version": 3,
  "name": "IS Message Watchdog",
  "version": "1.1.1",
  "description": "Monitor multiple Integration Suite tenants for nine hours each and email failures or interrupted monitoring.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "scripting",
    "notifications",
    "power"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IS Message Watchdog"
  }
}
