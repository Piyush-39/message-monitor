SMTP_USER=example@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
ALERT_TO=example@gmail.com
RELAY_TOKEN=generated_by_npm_run_setup

# Choose email (default), discord or teams. Webhook modes do not use Gmail.
NOTIFICATION_PROVIDER=email
# Or run npm run setup:discord to save these privately.
DISCORD_WEBHOOK_URL=

# Or run npm run setup:teams to save a Teams Workflows webhook privately.
TEAMS_WEBHOOK_URL=
